 191   1          (win_str_data.use_run_time + win_str_data.use_pause_time);
 192   1        if(total_minutes > win_str_data.use_pause_time)
 193   1        {
 194   2          total_minutes -= win_str_data.use_pause_time;
 195   2        }
 196   1        else
 197   1        {
 198   2          total_minutes = 0;
 199   2        }
 200   1      
 201   1        return total_minutes * 60;
 202   1      }
