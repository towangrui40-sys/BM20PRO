 153          static void win_calc_function(void)
 154          {
 155   1        float xdata temp,temp1;
 156   1        
 157   1        temp = product_data[win_str_data.product_id].vol_max-product_data[win_str_data.product_id].vol_min;
 158   1        temp1 = product_data[win_str_data.product_id].para1.max-product_data[win_str_data.product_id].para1.min;
 159   1        win_str_data.k_factor = temp/temp1;
 160   1        
 161   1        temp = win_str_data.k_factor*product_data[win_str_data.product_id].para1.min;
 162   1        win_str_data.b_factor = product_data[win_str_data.product_id].vol_min-temp;
 163   1      }
 164          
 165          u16 win_level_trans_volt(u16 level)
 166          {
 167   1        float xdata temp;
 168   1        u16 vol;
 169   1      
 170   1        temp = win_str_data.k_factor * level;
 171   1        temp += win_str_data.b_factor;
 172   1        vol = (u16)temp;
 173   1      
 174   1        return vol;
 175   1      }
