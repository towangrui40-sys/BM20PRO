 168          u16 win_level_trans_volt(u16 level)
 169          {
 170   1        float xdata temp;
 171   1        u16 vol;
 172   1      
 173   1        temp = win_str_data.k_factor * level;
 174   1        temp += win_str_data.b_factor;
 175   1        vol = (u16)temp;
 176   1      
 177   1        return vol;
