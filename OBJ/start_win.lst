 702   3            val += (btn_val == BTN_VAL_0) ? 0 : btn_val;
 703   3          }
 704   2        }
 705   1        else
 706   1        {
 707   2          return old_val;
 708   2        }
 709   1      
 710   1        para_keypad_first_digit = 0;
 711   1        return val;
 712   1      }
