 150          static void win_calc_function(void)
 151          {
 152   1        float xdata temp,temp1;
 153   1        
 154   1        temp = product_data[win_str_data.product_id].vol_max-product_data[win_str_data.product_id].vol_min;
 155   1        temp1 = product_data[win_str_data.product_id].para1.max-product_data[win_str_data.product_id].para1.min;
 156   1        win_str_data.k_factor = temp/temp1;
 157   1        
 158   1        temp = win_str_data.k_factor*product_data[win_str_data.product_id].para1.min;
 159   1        win_str_data.b_factor = product_data[win_str_data.product_id].vol_min-temp;
 160   1      }
