  53          static void btn_click_event(STR_BTN_TypeDef *obj)
  54          {
  55   1        u16 val;
  56   1        sys_read_vp(obj->addr,(u8*)&obj->val,1);
  57   1        switch(obj->type)
  58   1        {
  59   2          case BTN_TYPE_CLICK:
  60   2            //检查是否有按钮按下
  61   2            if(obj->val !=0)
  62   2            {
  63   3              //按钮点击事件处理,传递给相应的界面 
  64   3              obj->func_callback(obj->addr,obj->val);     
  65   3              //清除按键值
  66   3              obj->val = 0;
  67   3              sys_write_vp(obj->addr,(u8*)&obj->val,1); 
  68   3            }
  69   2            break;
  70   2          case BTN_TYPE_HOLD_RES:
  71   2            if(obj->val !=obj->val_temp)
  72   2            {
  73   3              obj->func_callback(obj->addr,obj->val);     
  74   3              obj->val_temp = obj->val;
  75   3              val=1;
  76   3              sys_write_vp(HOLD_ACTIVE_ADDR,(u8*)&val,1);
  77   3              val=0;
  78   3              sys_write_vp(HOLD_PASSIVE_ADDR,(u8*)&val,1);
  79   3            }       
  80   2            break;
  81   2          case BTN_TYPE_HOLD_TIME://click event,selected func
  82   2            if(obj->val !=0)
  83   2            {   
  84   3              if((obj->timer <10)&&(obj->val != obj->val_temp))
  85   3              {
  86   4                obj->func_callback(obj->addr,obj->val); 
  87   4              }
  88   3              if(obj->timer ==20)// 600ms hold event,popup shotkey select menu
  89   3              {
  90   4                obj->func_hold_callback(obj->addr,obj->val);
  91   4                //清除按键值
  92   4                obj->val = 0;
  93   4                sys_write_vp(obj->addr,(u8*)&obj->val,1);   
  94   4              }
  95   3              obj->timer++;
  96   3            }
  97   2            else
  98   2            {
  99   3              obj->timer = 0;
 100   3            }
 101   2            obj->val_temp = obj->val;
 102   2            break;
 103   2          default:
 104   2            break;
 105   2        }
 106   1      }
