 233   1        if(win_str_data.language >= 3) win_str_data.language = 0;
 234   1        if(win_str_data.language <= 0) win_str_data.language = 0; 
 235   1        sys_write_vp(BTN_LANGUAGE_ADDR,(u8*)&win_str_data.language,1);
