 675          static u16 win_para_keypad_input(u16 old_val, u16 btn_val)
 676          {
 677   1        u16 xdata val;
 678   1      
 679   1        if(btn_val == BTN_VAL_cancel)
 680   1        {
 681   2          if(para_keypad_first_digit)
 682   2          {
 683   3            val = 0;
 684   3          }
 685   2          else
 686   2          {
 687   3            val = old_val / 10;
 688   3          }
 689   2        }
 690   1        else if((btn_val >= BTN_VAL_1) && (btn_val <= BTN_VAL_0))
 691   1        {
 692   2          if(para_keypad_first_digit)
 693   2          {
 694   3            val = (btn_val == BTN_VAL_0) ? 0 : btn_val;
 695   3          }
 696   2          else
 697   2          {
 698   3            val = (old_val % 1000) * 10;
 699   3            val += (btn_val == BTN_VAL_0) ? 0 : btn_val;
 700   3          }
 701   2        }
 702   1        else
 703   1        {
 704   2          return old_val;
 705   2        }
 706   1      
 707   1        para_keypad_first_digit = 0;
 708   1        return val;
 709   1      }
