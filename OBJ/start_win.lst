 263          static void win_load_setpara(void)
 264          {
 265   1        if(win_str_data.logo >0) win_str_data.logo = 4;
 266   1        sys_write_vp(ANIMOTION_LOGO_ADDR,(u8*)&win_str_data.logo,2);  //no logo for oem
 267   1      
 268   1        if(win_str_data.light > 100) win_str_data.light = 100;
 269   1        if(win_str_data.light < 10) win_str_data.light = 10;
 270   1        sys_setdis_light(win_str_data.light);
 271   1        sys_write_vp(BTN_SET_LIGHT_ADDR,(u8*)&win_str_data.light,1);
 272   1        if(win_str_data.shake > 150) win_str_data.shake = 150;
 273   1        if(win_str_data.shake < 10) win_str_data.shake = 10;
 274   1        sys_write_vp(BTN_SET_SHAKE_ADDR,(u8*)&win_str_data.shake,1);
 275   1        if(win_str_data.alarm > 1) win_str_data.alarm = 1;
 276   1        if(win_str_data.alarm < 0) win_str_data.alarm = 0;
 277   1        sys_enable_speaker(1-win_str_data.alarm);
 278   1        sys_write_vp(BTN_SET_BUZZ_ADDR,(u8*)&win_str_data.alarm,1);
 279   1        
 280   1        if(win_str_data.language >= 3) win_str_data.language = 0;
 281   1        if(win_str_data.language <= 0) win_str_data.language = 0;
 282   1        sys_write_vp(BTN_LANGUAGE_ADDR,(u8*)&win_str_data.language,1);
 283   1      }
