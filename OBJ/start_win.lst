 159          static void win_calc_function(void)
 160          {
 161   1        float xdata temp,temp1;
 162   1        
 163   1        temp = product_data[win_str_data.product_id].vol_max-product_data[win_str_data.product_id].vol_min;
 164   1        temp1 = product_data[win_str_data.product_id].para1.max - 1;
 165   1        win_str_data.k_factor = temp/temp1;
 166   1        
 167   1        temp = win_str_data.k_factor * 1;
 168   1        win_str_data.b_factor = product_data[win_str_data.product_id].vol_min-temp;
 169   1      }
