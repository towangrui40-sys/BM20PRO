 463   1        {
 464   2          win_change_page(POPUP_CASE);       //等待盖子到位
 465   2          RTU_Cmd_Pending(RTU_STOP,MC_STOP);
 466   2          RTU_Cmd_Pending(RTU_CASE_ACTION,OPEN);
 467   2          win_str_data.state = FSM_POSITION_CHECK;
 468   2        }
 469   1      
 470   1        if(win_str_data.state == FSM_READY || win_str_data.state == FSM_PAUSE) 
 471   1        {
 472   2          if(str_sys.location_test == 0x02 && win_str_data.lid_cmd == 0x01)  // turn to No.2 seat  open the lid
 473   2          {
 474   3            win_str_data.lid_cmd = 0x00;                //开盖命令只发送一次
 475   3            win_change_page(POPUP_CASE);   //等待盖子到位界面
 476   3            RTU_Cmd_Pending(RTU_STOP,MC_STOP);
