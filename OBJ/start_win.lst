 223   1        sys_setdis_light(win_str_data.light);
 224   1        sys_write_vp(BTN_SET_LIGHT_ADDR,(u8*)&win_str_data.light,1);  
 225   1        if(win_str_data.shake > 150) win_str_data.shake = 150;
