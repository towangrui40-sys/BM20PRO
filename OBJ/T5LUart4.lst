 144          //解析处理数据
 145          unsigned char HMICommand()
 146          {
 147   1        unsigned char i;
 148   1        unsigned int tmp;
 149   1        unsigned char retVal;
 150   1      // 返回0 不发送数据 返回1发送数据
 151   1        retVal=0;
 152   1        switch (HmiSlvBuff.Item.Command)
 153   1        {
 154   2        case 3: //读取
 155   2          if (HmiSlvBuff.Item.DataValue==0 || HmiSlvBuff.Item.DataValue>115)
 156   2          {//异常或读取内容禁止处理   
 157   3            return 0;
 158   3          }
 159   2          HmiSlvSendBuff[0]=HmiSlvCmd.Addr;
 160   2          HmiSlvSendBuff[1]=3;
 161   2          HmiSlvSendBuff[2]=HmiSlvBuff.Item.DataValue*2;
 162   2          HmiSlvCmd.SendLength=HmiSlvSendBuff[2]+5;
 163   2          tmp=HmiSlvBuff.Item.RegisterAddr*2;
 164   2          T5L_ReadDgusBytes(HmiSlvBuff.Item.RegisterAddr,&HmiSlvSendBuff[3],HmiSlvSendBuff[2]);
 165   2          retVal=1;
 166   2          break;
 167   2        case 6: //写入
 168   2          T5L_WriteDgusBytes(HmiSlvBuff.Item.RegisterAddr,&HmiSlvBuff.Value[4],2);
 169   2          HmiSlvCmd.SendLength=8;
 170   2          for (i=0;i<6;i++)
 171   2          {
 172   3            HmiSlvSendBuff[i]=HmiSlvBuff.Value[i];
 173   3          }
 174   2          retVal=1;
