 632   1        if(btn_val == BTN_VAL_cancel)
 633   1        {
 634   2          if(para_keypad_first_digit)
 635   2          {
 636   3            val = 0;
 637   3          }
 638   2          else
 639   2          {
 640   3            val = old_val / 10;
 641   3          }
 642   2        }
 643   1        else if((btn_val >= BTN_VAL_1) && (btn_val <= BTN_VAL_0))
 644   1        {
 645   2          if(para_keypad_first_digit)
 646   2          {
 647   3            val = (btn_val == BTN_VAL_0) ? 0 : btn_val;
 648   3          }
 649   2          else
 650   2          {
 651   3            val = (old_val % 1000) * 10;
 652   3            val += (btn_val == BTN_VAL_0) ? 0 : btn_val;
 653   3          }
 654   2        }
 655   1        else
 656   1        {
 657   2          return old_val;
 658   2        }
 659   1      
 660   1        para_keypad_first_digit = 0;
