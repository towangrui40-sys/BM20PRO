 156          static void win_calc_function(void)
 157          {
 158   1        float xdata temp,temp1;
 159   1        
 160   1        temp = product_data[win_str_data.product_id].vol_max-product_data[win_str_data.product_id].vol_min;
 161   1        temp1 = product_data[win_str_data.product_id].para1.max-product_data[win_str_data.product_id].para1.min;
 162   1        win_str_data.k_factor = temp/temp1;
 163   1        
 164   1        temp = win_str_data.k_factor*product_data[win_str_data.product_id].para1.min;
 165   1        win_str_data.b_factor = product_data[win_str_data.product_id].vol_min-temp;
 166   1      }
