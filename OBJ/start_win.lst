 157          static void win_calc_function(void)
 158          {
 159   1        float xdata temp,temp1;
 160   1        
 161   1        temp = product_data[win_str_data.product_id].vol_max-product_data[win_str_data.product_id].vol_min;
 162   1        temp1 = product_data[win_str_data.product_id].para1.max - 1;
 163   1        win_str_data.k_factor = temp/temp1;
 164   1        
 165   1        temp = win_str_data.k_factor * 1;
 166   1        win_str_data.b_factor = product_data[win_str_data.product_id].vol_min-temp;
 167   1      }
 168          
 169          u16 win_level_trans_volt(u16 level)
 170          {
 171   1        float temp;
 172   1        temp = level;
 173   1        
 174   1        temp = (float)(win_str_data.k_factor * temp)+win_str_data.b_factor; 
 175   1      
 176   1        return (u16)temp;
 177   1      }
