 136          //初始显示通讯程序
 137          void T5L_HMIslvInit()
 138          {
 139   1        HmiSlvCmd.Addr=1; //ModBus 地址为1
 140   1        HmiSlvCmd.Status=0;
 141   1        HmiSlvCmd.Step=0; 
