 585          void HFPeriod_1msTask(void)
 586          {
 587   1        btn_click_handler();
 588   1        rtu_response_handler();
 589   1        win_fresh_window();
 590   1      
 591   1        if(win_str_data.state == FSM_INIT_WAIT_POS2 && str_sys.location_test == 0x02)
 592   1        {
 593   2          win_change_page(POPUP_CASE);       //等待盖子到位
 594   2          RTU_Cmd_Pending(RTU_STOP,MC_STOP);
 595   2          RTU_Cmd_Pending(RTU_CASE_ACTION,OPEN);
 596   2          win_str_data.state = FSM_POSITION_CHECK;
 597   2        }
 598   1      
 599   1        if(win_str_data.state == FSM_READY || win_str_data.state == FSM_PAUSE) 
 600   1        {
 601   2          if(str_sys.location_test == 0x02 && win_str_data.lid_cmd == 0x01)  // turn to No.2 seat  open the lid
 602   2          {
C51 COMPILER V9.60.7.0   TASK_MANAGER                                                      10/27/2026 13:38:32 PAGE 11  

 603   3            win_str_data.lid_cmd = 0x00;                //开盖命令只发送一次
 604   3            win_change_page(POPUP_CASE);   //等待盖子到位界面
 605   3            RTU_Cmd_Pending(RTU_STOP,MC_STOP);
 606   3            RTU_Cmd_Pending(RTU_CASE_ACTION,OPEN);  //发送开盖命令
 607   3            win_str_data.state = FSM_POSITION_CHECK; //等待开盖到位后复位锁紧装置，再进入选罐
 608   3          }
 609   2        }
 610   1      }
