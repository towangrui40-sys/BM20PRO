 175   2          break;
 176   2        case 16: //批量写入
 177   2          if(HmiSlvBuff.ItemX.DataValue==0 || HmiSlvBuff.ItemX.DataValue>125) return 0; //不能超过125个 word
 178   2          T5L_WriteDgusBytes(HmiSlvBuff.Item.RegisterAddr,HmiSlvBuff.ItemX.uint8,HmiSlvBuff.ItemX.ByteCount);   
 179   2          HmiSlvCmd.SendLength=8;
 180   2          for (i=0;i<6;i++)
 181   2          {
 182   3            HmiSlvSendBuff[i]=HmiSlvBuff.Value[i];
 183   3          }
 184   2          retVal=1;
 185   2          break;
 186   2        default:
 187   2          return 0;
 188   2        }
 189   1        return retVal;
 190   1      }
 191          //远程通讯响应子程序 返回2 解析命令
 192          unsigned char T5L_HMIslvSub()
 193          {
 194   1        unsigned char i;
 195   1        unsigned int tmp;
 196   1        unsigned char retVal;
 197   1        if (HmiSlvCmd.Status!=2) return 0;
 198   1        retVal=HMICommand();
 199   1        if (retVal==0)
 200   1        {
 201   2          HmiSlvCmd.Status=0;//无返回
 202   2          HmiSlvCmd.Step=0;
 203   2          return 0;
 204   2        }
 205   1        
 206   1        HmiSlvCmd.JsCrc.Data=0xffff;
 207   1        for (i=0;i<HmiSlvCmd.SendLength-2;i++){//计算包头块CRC
 208   2          tmp=CRC16_TABLE[(HmiSlvCmd.JsCrc.Data^HmiSlvSendBuff[i])&0x00ff];
 209   2          HmiSlvCmd.JsCrc.Data=(HmiSlvCmd.JsCrc.Data>>8)^tmp;
 210   2        }
 211   1        HmiSlvSendBuff[HmiSlvCmd.SendLength-2]=HmiSlvCmd.JsCrc.Value[1];
 212   1        HmiSlvSendBuff[HmiSlvCmd.SendLength-1]=HmiSlvCmd.JsCrc.Value[0];
 213   1      
 214   1        //发送数据
 215   1        HmiSlvCmd.Step=0;
 216   1        HmiSlvCmd.Length=1;
 217   1        HmiSlvCmd.Status=3;
 218   1        SBUF2_TX=HmiSlvSendBuff[0];
 219   1        return retVal;
